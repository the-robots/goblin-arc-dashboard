const express = require("express");const cors = require("cors");const app = express();const PORT = 3000;app.use(cors());app.use(express.json());app.get("/api/pods",(req,res)=>{console.log("👀 Received request for /api/pods");res.json({items:[{metadata:{name:"arc-actions-runner-controller-5d89974488-h7mss"}},{metadata:{name:"goblin-runner-s9rbq-n6dm8"}}]});});app.use((req,res)=>{console.warn(`⚠️ Unknown route: ${req.method} ${req.url}`);res.status(404).json({error:"Route not found"});});app.listen(PORT,"0.0.0.0",()=>{console.log(`🟢 Goblin dashboard backend running at http://0.0.0.0:${PORT}`);});
