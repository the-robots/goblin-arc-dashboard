'use client';
import { useEffect, useState } from 'react';
import io from 'socket.io-client';

type Pod = {
  metadata: { name: string; namespace: string };
  status?: { phase: string };
};

export default function Dashboard() {
  const [pods, setPods] = useState<Pod[]>([]);

  useEffect(() => {
    const socket = io('http://192.168.1.229:3000'); // Backend server
    socket.on('pods:init', (items: Pod[]) => setPods(items));

    socket.on('pods:update', (event: any) => {
      const { type, pod } = event;
      setPods((prev) => {
        const name = pod.metadata.name;
        if (type === 'ADDED') return [...prev, pod];
        if (type === 'DELETED') return prev.filter((p) => p.metadata.name !== name);
        if (type === 'MODIFIED')
          return prev.map((p) => (p.metadata.name === name ? pod : p));
        return prev;
      });
    });

    return () => {
      socket.disconnect();
    };
  }, []);

  return (
    <main className="p-6 min-h-screen bg-gray-50">
      <h1 className="text-3xl font-bold mb-6">🧩 Goblin K3s Pod Dashboard</h1>

      {pods.length === 0 ? (
        <p className="text-gray-600">Loading pods...</p>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {pods.map((pod) => (
            <div
              key={pod.metadata.name}
              className="p-4 border rounded-xl shadow-sm bg-white hover:shadow-md transition"
            >
              <h2 className="font-semibold text-lg">{pod.metadata.name}</h2>
              <p className="text-sm text-gray-500">
                Namespace: {pod.metadata.namespace}
              </p>
              <p className="mt-2 text-sm">
                Status:{" "}
                <span
                  className={
                    pod.status?.phase === 'Running'
                      ? 'text-green-600 font-semibold'
                      : pod.status?.phase === 'Pending'
                      ? 'text-yellow-600 font-semibold'
                      : 'text-red-600 font-semibold'
                  }
                >
                  {pod.status?.phase}
                </span>
              </p>
            </div>
          ))}
        </div>
      )}
    </main>
  );
}

